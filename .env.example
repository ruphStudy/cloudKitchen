# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys for testing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook (Dashboard → Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Same value as RAZORPAY_KEY_ID (the key id is public; the secret is not)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Admin access: comma-separated emails (also allowed: rows in the `admins` table)
ADMIN_EMAILS=you@example.com
# Public URL of the site, used in magic-link emails (e.g. https://orders.example.com). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only for `npm run test:db` (Supabase → Project Settings → Database → Connection string)
DATABASE_URL=
